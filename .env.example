# ==============================================================================
# JARVIS Environment Configuration Example
# Copy this file to .env and configure the values for your environment.
# Never commit the actual .env file with secrets into version control.
# ==============================================================================

# Application Environment (development, production, testing)
APP_ENV=development
APP_NAME=JARVIS
DEBUG=true
LOG_LEVEL=INFO

# Application Language & Locale (en = English, fa = Persian)
APP_LANGUAGE=en

# Google Gemini API Settings
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_REQUEST_TIMEOUT=30.0
CONVERSATION_HISTORY_LIMIT=20

# Storage & Paths (Leave blank to use default project data directories)
# DATA_DIR=
# LOGS_DIR=

# ==============================================================================
# Voice Intelligence & ElevenLabs TTS Configuration (Phase 9 & 10)
# ==============================================================================
VOICE_ENABLED=true
VOICE_WAKE_WORD=Jarvis
VOICE_WAKE_WORD_ENABLED=true
VOICE_CONTINUOUS_LISTENING=true
VOICE_CLOUD_STT_CONSENT=false
VOICE_CLOUD_TTS_CONSENT=true
VOICE_TTS_ENABLED=true
VOICE_TTS_ENGINE=elevenlabs
VOICE_RESPONSE_LANGUAGE=en

# ElevenLabs British Neural Voice Settings
# Obtain an API key from https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.75
ELEVENLABS_SIMILARITY_BOOST=0.85
ELEVENLABS_STYLE=0.15
ELEVENLABS_USE_SPEAKER_BOOST=true

# Response Language Policy:
# - DEFAULT_ENGLISH: British English responses for Persian/English input unless Persian is explicitly asked for
# - PERSIAN: Always respond in Persian
# - FOLLOW_USER: Match the user's input language
RESPONSE_LANGUAGE_POLICY=DEFAULT_ENGLISH

# Azure Cognitive Speech (Fallback Tier 2)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
VOICE_BRITISH_VOICE=en-GB-OliverNeural

