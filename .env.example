# ==============================================================================
# JARVIS Environment Configuration Example
# Copy this file to .env and configure the values for your environment.
# Never commit the actual .env file with secrets into version control.
# ==============================================================================

# Application Environment (development, production, testing)
APP_ENV=development
APP_NAME=JARVIS
DEBUG=true
LOG_LEVEL=INFO

# Application Language & Locale (en = English, fa = Persian)
APP_LANGUAGE=en

# Google Gemini API Settings
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_REQUEST_TIMEOUT=30.0
CONVERSATION_HISTORY_LIMIT=20

# Storage & Paths (Leave blank to use default project data directories)
# DATA_DIR=
# LOGS_DIR=
